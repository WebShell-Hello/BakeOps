COMPOSE_PROJECT_NAME=bakeops-prod

# Replace with a strong production database password before deployment.
POSTGRES_DB=bakeops
POSTGRES_USER=bakeops
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Use a long random value. Example generator:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEFAULT_USER_PASSWORD=replace-before-creating-users
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECURE_SSL_REDIRECT=true

# Primary public hostname. Do not include https:// here.
BAKEOPS_DOMAIN=bakeops.example.com

# Django host/origin allow-lists for production.
DJANGO_ALLOWED_HOSTS=bakeops.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://bakeops.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bakeops.example.com

# Browser API calls remain same-origin through Caddy.
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
